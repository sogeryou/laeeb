NODE_ENV=development
PORT=3000
JWT_SECRET=dev-only-change-me-use-64-chars-minimum-in-production-xxxxxxxxxxxx
ADMIN_EMAIL=admin@le3eb.club
ADMIN_PASSWORD=change-me-8chars
CORS_ALLOWLIST=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://le3eb:le3eb@localhost:5432/le3eb
REDIS_URL=redis://localhost:6379
PAYMENT_PROVIDER=sandbox
SANDBOX_SECRET=dev-sandbox
SETTLEMENT_TZ=Asia/Riyadh
SETTLEMENT_CRON_DISABLED=false
STORAGE_BACKEND=json

# Authentication calendar defaults to UTC; change explicitly for the platform.
AUTH_PLATFORM_TZ=UTC
# Explicit local testing only: returns a clearly labeled developmentCode, sends no mail.
AUTH_EMAIL_DELIVERY=development
# Production: set AUTH_EMAIL_DELIVERY=provider and configure a verified sender.
# AUTH_MAIL_API_KEY=
# AUTH_MAIL_FROM=Le3eb <auth@example.com>
# AUTH_MAIL_ENDPOINT=https://api.resend.com/emails
# AUTH_AVATAR_DIR=/persistent-volume/auth-avatars
